flowchart TB
    TASK["task text"]:::grey
    CFG["config"]:::grey
    CLIENT["model client"]:::grey
    REPLY["reply"]:::grey
    OUT["stdout"]:::grey

    PARSE["parse reply<br/>text or tool call"]:::green
    DISP["dispatcher<br/>the single chokepoint"]:::green
    REG["tool registry<br/>read · write · list · bash"]:::green
    WORLD[("filesystem · shell")]:::green
    SHAPE["result shaping<br/>cap · elide"]:::green
    HIST["transcript<br/>in memory"]:::green
    CEIL["turn ceiling"]:::green

    TASK --> CFG --> CLIENT --> REPLY --> PARSE
    PARSE -- "final answer" --> OUT
    PARSE -- "tool call" --> DISP --> REG --> WORLD
    REG --> SHAPE --> HIST
    HIST -- "next request" --> CLIENT
    REG -. "tools · what it may call" .-> CLIENT
    CEIL -. "halts the loop" .-> OUT

    classDef grey fill:#ECEFF1,stroke:#90A4AE,color:#37474F
    classDef green fill:#E8F5E9,stroke:#2E7D32,color:#1B5E20
