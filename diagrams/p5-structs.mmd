flowchart LR
    MAIN["main<br/>builds, prints"]:::existing
    LOOP["agent::run<br/>can suspend"]:::changed
    CLIENT["Client<br/>one POST"]:::existing
    REG["Registry<br/>finds, validates, runs"]:::existing
    TOOLS["ReadFile · ListDir<br/>WriteFile · Bash"]:::existing
    LOG["Log<br/>writes, reads the record"]:::existing
    REPLAY["replay()<br/>re-derives a run"]:::existing
    PROJECT["project()<br/>masks old results"]:::existing
    RESUME["resume()<br/>continues a suspended run"]:::added
    PROV["provider"]:::external

    MAIN -->|"Request · Limits · Policy"| LOOP
    MAIN -->|"Config · tools"| CLIENT
    LOOP -->|"Request, full"| PROJECT
    PROJECT -->|"Request, masked"| CLIENT
    CLIENT -->|"Wire"| PROV
    PROV -->|"bytes"| CLIENT
    CLIENT -->|"Reply"| LOOP
    LOOP -->|"ToolCall, once the gate allows it"| REG
    REG -->|"Args<br/>&amp;Workspace"| TOOLS
    TOOLS -->|"Observation"| REG
    REG -->|"Observation, shaped"| LOOP
    LOOP -->|"Ending"| MAIN
    LOOP -->|"Event · approval"| LOG
    LOG -->|"Vec&lt;Event&gt;"| REPLAY
    REPLAY -. "decide()" .-> LOOP
    LOG -->|"Vec&lt;Event&gt;"| RESUME
    RESUME -->|"decision, then live"| LOOP

