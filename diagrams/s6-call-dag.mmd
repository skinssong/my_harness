%%{init: {"flowchart": {"wrappingWidth": 320}}}%%
flowchart TB
    START(["harness compose notes/ · assemble into report.md"])

    SCAN["main reads notes/<br/>4 files · not a tool call<br/>not in any record"]:::tool
    START --> SCAN
    SCAN --> D1 & D2 & D3 & D4

    subgraph FAN["fan-out · bounded at 4 · runs concurrently"]
        D1["child · alpha.md<br/>2 model calls<br/>own record"]:::llm
        D2["child · beta.md<br/>2 model calls<br/>own record"]:::llm
        D3["child · delta.md<br/>2 model calls<br/>own record"]:::llm
        D4["child · gamma.md<br/>2 model calls<br/>own record"]:::llm
        D1 --> C1["claim · 168 B"]:::join
        D2 --> C2["claim · 150 B"]:::join
        D3 --> C3["claim · 140 B"]:::join
        D4 --> C4["claim · 170 B"]:::join
    end

    C1 --> COMP
    C2 --> COMP
    C3 --> COMP
    C4 --> COMP
    COMP["main composes the task<br/>instruction + four claims<br/>joined in file order"]:::tool

    COMP --> P1["P1 · parent turn 1<br/>decides the order"]:::llm
    P1 -->|"bash"| G1{"bash = Ask"}:::gate
    G1 -->|"approved<br/>exit 3 → resume"| CAT["cat γ β α δ &gt; report.md<br/>report.md written"]:::tool
    G1 -.->|"denied"| ND["observation:<br/>denied by the operator"]:::tool
    CAT --> P2
    ND --> P2

    P2["P2 · parent turn 2<br/>checks its own seam"]:::llm
    P2 -->|"bash"| G2{"bash = Ask"}:::gate
    G2 -->|"approved"| CHK["head -1 · tail -1"]:::tool
    CHK --> P3["P3 · parent turn 3"]:::llm
    P3 --> END(["answer · exit 0"])

