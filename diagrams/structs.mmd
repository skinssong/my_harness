flowchart TB
    MAIN["main<br/>parses, builds, prints"]:::old
    LOOP["agent::run<br/>decides the next step"]:::old
    CLIENT["Client<br/>one POST"]:::old
    REG["Registry<br/>finds, validates, runs"]:::old
    TOOLS["ReadFile · ListDir<br/>WriteFile · Bash"]:::old

    LOG["Log<br/>writes, reads the record"]:::new
    REPLAY["replay()<br/>re-derives a run"]:::new

    PROV["provider<br/>not ours"]:::external

    MAIN -->|"Request · Limits"| LOOP
    MAIN -->|"Config · tools<br/>at build"| CLIENT
    LOOP -->|"Request"| CLIENT
    CLIENT -->|"Wire {model, messages, tools}"| PROV
    PROV -->|"bytes"| CLIENT
    CLIENT -->|"Reply"| LOOP
    LOOP -->|"ToolCall"| REG
    REG -->|"Args · &Workspace"| TOOLS
    TOOLS -->|"Observation"| REG
    REG -->|"Observation, shaped"| LOOP
    REG -->|"Vec&lt;Value&gt; tools"| MAIN
    LOOP -->|"Outcome"| MAIN

    LOOP -->|"Event"| LOG
    LOG -->|"Vec&lt;Event&gt;"| REPLAY
    REPLAY -. "decide()" .-> LOOP

