flowchart TB
    LOOP["loop<br/>pure decision + async driver"]:::amber
    CLIENT["model client"]:::grey
    REPLY["reply"]:::grey
    PARSE["parse reply<br/>text or tool call"]:::amber
    DISP["dispatcher"]:::grey
    REG["tool registry"]:::grey
    WORLD[("filesystem · shell")]:::grey
    SHAPE["result shaping"]:::grey
    HIST["transcript"]:::grey
    OUT["stdout"]:::grey

    LOG[("event log<br/>append-only")]:::green
    REPLAY["replay<br/>offline re-drive"]:::green
    BUDGET["cost budget"]:::green
    STUCK["stuck detector"]:::green

    LOOP --> CLIENT --> REPLY --> PARSE
    PARSE -- "final answer" --> OUT
    PARSE -- "tool call" --> DISP --> REG --> WORLD
    REG --> SHAPE --> HIST
    HIST -- "next turn" --> LOOP
    LOOP -. "appends every event" .-> LOG
    LOG --> REPLAY
    REPLAY -. "re-drives the same decisions" .-> LOOP
    BUDGET -. "halts" .-> LOOP
    STUCK -. "halts" .-> LOOP

    classDef grey fill:#ECEFF1,stroke:#90A4AE,color:#37474F
    classDef green fill:#E8F5E9,stroke:#2E7D32,color:#1B5E20
    classDef amber fill:#FFF8E1,stroke:#F9A825,color:#8D6E00
