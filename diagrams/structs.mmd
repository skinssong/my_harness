flowchart TB
    MAIN["main<br/>parses, builds, prints"]:::actor
    LOOP["agent::run<br/>decides the next step"]:::actor
    CLIENT["Client<br/>one POST"]:::actor
    REG["Registry<br/>finds, validates, runs"]:::actor
    TOOLS["ReadFile · ListDir<br/>WriteFile · Bash<br/>(one chosen per call)"]:::actor
    PROV["provider<br/>not ours"]:::external

    MAIN -->|"Request · Limits"| LOOP
    MAIN -->|"Config · tools<br/>(once, at construction)"| CLIENT
    LOOP -->|"Request"| CLIENT
    CLIENT -->|"Wire {model, messages, temperature, tools}"| PROV
    PROV -->|"response bytes"| CLIENT
    CLIENT -->|"Reply"| LOOP
    LOOP -->|"ToolCall"| REG
    REG -->|"Args · &Workspace"| TOOLS
    TOOLS -->|"Observation"| REG
    REG -->|"Observation, shaped"| LOOP
    REG -->|"Vec&lt;Value&gt; — the tools array"| MAIN
    LOOP -->|"Outcome"| MAIN

    classDef actor fill:#E8F5E9,stroke:#2E7D32,color:#1B5E20
