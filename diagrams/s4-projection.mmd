%%{init: {"flowchart": {"wrappingWidth": 320}}}%%
flowchart TB
    subgraph PIN["pinned · never touched"]
        S["system"]
        T["user · find the failing test"]
        S --> T
    end

    subgraph OLD["older turns · tool results replaced by a marker"]
        A1["assistant → bash · cat build.log"]
        M1["[masked: was 8,192 bytes; rerun the command if needed]"]
        A2["assistant → bash · grep FAIL log"]
        R2["tool · exit 0 · FAILED test_login"]
        A1 --> M1 --> A2 --> R2
    end

    subgraph TAIL["last 2 turns · kept verbatim"]
        A3["assistant → read_file · log"]
        R3["tool · exit 0 · …"]
        A3 --> R3
    end

    T --> A1
    R2 --> A3

    classDef kept fill:#ECEFF1,stroke:#90A4AE,color:#37474F
    classDef pinned fill:#ECEFF1,stroke:#37474F,color:#1C2B33,stroke-width:2px
    classDef masked fill:#FFF3E0,stroke:#EF6C00,color:#E65100,stroke-dasharray:4 3

    class S,T pinned
    class A1,A2,R2,A3,R3 kept
    class M1 masked

    style PIN fill:#FFFFFF,stroke:#B0BEC5
    style OLD fill:#FFFFFF,stroke:#B0BEC5
    style TAIL fill:#FFFFFF,stroke:#B0BEC5
